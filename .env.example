# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Postgres (docker compose 의 postgres 서비스와 일치) ---
# NOTE: 형제 프로젝트(knowledge-rag 등)와의 포트 충돌을 피하기 위해 5433/6433/8001 사용
POSTGRES_USER=regulations
POSTGRES_PASSWORD=regulations
POSTGRES_DB=regulations
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_URL=postgresql+psycopg://regulations:regulations@localhost:5433/regulations

# --- Qdrant ---
QDRANT_URL=http://localhost:6433
QDRANT_COLLECTION=regulations

# --- 모델 ---
# NOTE: fastembed 가 BAAI/bge-m3 dense 를 직접 지원 안 함 (M3 시작 시 발견).
#   가장 비슷한 multilingual 대체재로 intfloat/multilingual-e5-large 사용.
#   ADR-? 참고. 한국어 정확도는 e5-large > bge-large-en > multilingual-mpnet 순.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
LLM_MODEL=gpt-4o-mini
RERANKER_MODEL=BAAI/bge-reranker-base
# Retrieval reranker (ISSUE-001, ADR-020). fastembed 미지원 모델(bge-v2-m3 등) 주의.
RERANK_ENABLED=true
RERANK_CANDIDATE_K=60
# 별표 표를 행 단위 자연어 청크로 분할 (검색 보강, ISSUE-001)
LINEARIZE_APPENDIX_TABLES=true
OCR_LANG=ko-KR

# --- 디렉토리 ---
INGEST_DIR=./ingest
DATA_DIR=./data

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:3000

# --- Worker ---
INDEXER_POLL_INTERVAL_SEC=2
INDEXER_BATCH_SIZE=1

# --- LangGraph ---
# LANGGRAPH_CHECKPOINT_URL 비우면 POSTGRES_URL 재사용
LANGGRAPH_CHECKPOINT_URL=
